rules_version = '2';

// Every task and habit belongs to one user. Only that user can touch it,
// and nobody can move a document to another user.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
    }

    match /habits/{habitId} {
      allow read, delete: if isOwner(resource.data);
      allow create: if isOwner(request.resource.data);
      allow update: if isOwner(resource.data) && isOwner(request.resource.data);
    }
  }
}
